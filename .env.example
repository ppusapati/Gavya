# Copy to .env before `docker compose up`. Compose refuses to start without
# both of these rather than falling back to a default, because a password with
# a default is a password that reaches production — the compose file is what
# gets copied.

# The PostgreSQL superuser. Owns the tables, runs migrations, and holds
# BYPASSRLS, so nothing that serves requests should ever use it.
POSTGRES_PASSWORD=

# The role every service connects as. NOSUPERUSER, NOBYPASSRLS, owns nothing:
# it cannot see past the tenant isolation policies by any route.
GAVYA_APP_PASSWORD=
