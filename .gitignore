
# Rust build artifacts
/ml/target/

# Local credentials for docker compose; .env.example is the template.
.env

# Compiled binaries from `go build ./...` run inside a service directory.
# One of these — a 30MB modulith — was committed and went unnoticed, because a
# binary in the tree breaks nothing and every test still passes.
/services/*/server
/services/*/cmd/server/server

# Backups and generated secrets. Both contain live data or a live credential and
# neither belongs in git; scripts/backup.sh and scripts/make-secrets.sh write
# here by default so that an accident is harder than getting it right.
/backups/
/secrets/
*-secret.yaml
e2e/provision
